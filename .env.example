# Backend API port (local). On Render, Render sets PORT for you.
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Ai_v_search_E
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash
# If Gemini is unavailable, the backend automatically uses its local demo parser.

# Required for login, register, favourites, search history, and saved comparisons
JWT_SECRET=replace_with_a_long_random_secret

# Separate frontend URL (local React or Render Static Site)
FRONTEND_ORIGIN=http://localhost:3000

# Set to true only if Express should also serve frontend/dist (single-process mode)
SERVE_FRONTEND=false
